[Unit]
Description=LEITSTELLE 112 – Vermittlungsdienst
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=leitstelle
WorkingDirectory=/opt/leitstelle112
# Eigener Datenordner /var/lib/leitstelle112 (Protokolle, Cache) – unabhängig vom Home-Verzeichnis
StateDirectory=leitstelle112
CacheDirectory=leitstelle112
Environment=HOME=/var/lib/leitstelle112
Environment=XDG_DATA_HOME=/var/lib/leitstelle112/data
Environment=XDG_CONFIG_HOME=/var/lib/leitstelle112/config
Environment=XDG_CACHE_HOME=/var/cache/leitstelle112
ExecStart=/opt/leitstelle112/leitstelle112.x86_64 --headless -- --vermittlung --port=24180
Restart=always
RestartSec=5
# Schutz: Dienst darf nur sein eigenes Verzeichnis beschreiben
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/leitstelle112
PrivateTmp=true
MemoryMax=600M

[Install]
WantedBy=multi-user.target
