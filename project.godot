; LEITSTELLE 112 – Godot-Projektdatei
config_version=5

[application]

config/name="LEITSTELLE 112"
config/description="Simulation der Integrierten Leitstelle Bavaria"
config/version="1.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icons/icon.png"
config/windows_native_icon="res://assets/icons/icon.ico"
boot_splash/bg_color=Color(0.125, 0.137, 0.149, 1)
boot_splash/show_image=false
config/use_custom_user_dir=true
config/custom_user_dir_name="LEITSTELLE112"
run/flush_stdout_on_print=true

[autoload]

Data="*res://src/core/data.gd"
Settings="*res://src/settings/settings.gd"
LocalDB="*res://src/save/local_db.gd"
World="*res://src/map/world.gd"
State="*res://src/simulation/state.gd"
Sim="*res://src/simulation/sim.gd"
Net="*res://src/multiplayer/net.gd"
Audio="*res://src/audio/audio.gd"
Game="*res://src/core/game.gd"

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/unused_parameter=0
gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_signal=0
gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_global_identifier=0

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/min_width=1280
window/size/min_height=720
window/subwindows/embed_subwindows=true
window/energy_saving/keep_screen_on=false

[gui]

theme/default_font_antialiasing=1
theme/default_font_hinting=2

[input]

[rendering]

renderer/rendering_method="forward_plus"
environment/defaults/default_clear_color=Color(0.125, 0.137, 0.149, 1)
anti_aliasing/quality/msaa_2d=1
